# Copiar este archivo a ".env" y llenar con tus valores reales.
# ".env" NUNCA se sube a git (ya esta en .gitignore).

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True

# Token compartido que el ESP32 debe enviar en cada request para que el
# backend acepte el evento (evita que cualquiera dispare alarmas falsas).
DEVICE_API_KEY=clave-secreta-para-el-esp32

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_TEMPLATE_NAME=alerta_emergencia
WHATSAPP_TEMPLATE_LANG=es

# Twilio Voice
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Si es True, no se llama a ninguna API externa; solo se registra en logs
# y en la base de datos lo que se habria enviado. Util para desarrollo.
DRY_RUN=True
